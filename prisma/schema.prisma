generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RevisionGoal {
  NATURAL
  CONCISE
  PROFESSIONAL
  PERSONAL
  MATCH_SAMPLES
}

enum RevisionStatus {
  DRAFT
  GENERATED
  REVIEWED
  FINALIZED
}

enum ExportType {
  FINAL_TEXT
  TRACKED_DIFF
  REVISION_SUMMARY
  TRANSPARENCY_REPORT
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum SourceType {
  PASTED
  TXT
  PDF
  DOCX
}

enum DiffDecision {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  displayName        String?
  timezone           String?            @default("UTC")
  locale             String?            @default("en-US")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  projects           Project[]
  writingSamples     WritingSample[]
  voiceProfiles      VoiceProfile[]
  revisions          Revision[]
  transparencyReports TransparencyReport[]
  auditEvents        AuditEvent[]
  exportJobs         ExportJob[]
  oauthAccounts      OauthAccount[]
}

model OauthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([provider, providerAccountId])
}

model Project {
  id                   String             @id @default(uuid())
  userId               String
  title                String
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  archivedAt           DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocuments      SourceDocument[]
  revisions            Revision[]
  transparencyReports  TransparencyReport[]
  exportJobs           ExportJob[]
  auditEvents          AuditEvent[]

  @@index([userId])
}

model SourceDocument {
  id                  String       @id @default(uuid())
  projectId           String
  sourceType          SourceType
  originalFilename    String?
  storageKey          String?
  mimeType            String?
  content             String
  checksum            String?
  createdAt           DateTime     @default(now())
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions           Revision[]

  @@index([projectId])
}

model WritingSample {
  id                  String       @id @default(uuid())
  userId              String
  title               String
  sourceType          SourceType
  originalFilename    String?
  storageKey          String?
  content             String
  createdAt           DateTime     @default(now())
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VoiceProfile {
  id                       String      @id @default(uuid())
  userId                   String
  name                     String
  avgSentenceLength        Float
  preferredTransitions     String[]
  toneMarkers              String[]
  punctuationHabits        Json
  lexicalFeatures          Json
  sampleCount              Int
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions                Revision[]

  @@index([userId])
}

model Revision {
  id                          String          @id @default(uuid())
  projectId                   String
  userId                      String
  voiceProfileId              String?
  sourceDocumentId            String
  parentRevisionId            String?
  goal                        RevisionGoal
  readingLevel                String
  tone                        String
  formality                   Int
  aggressiveness              Int
  preserveTerminology         Boolean         @default(true)
  preserveSentenceStructure   Boolean         @default(false)
  preserveCitation            Boolean         @default(true)
  lockedSentences             Int[]
  lockedTerms                 String[]
  rewrittenText               String
  optionIndex                 Int             @default(1)
  semanticScore               Float
  driftWarnings               Json
  status                      RevisionStatus  @default(DRAFT)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  project                     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument              SourceDocument  @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  voiceProfile                VoiceProfile?   @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  parentRevision              Revision?       @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions              Revision[]      @relation("RevisionParent")
  sentenceDiffs               SentenceDiff[]

  @@index([projectId])
  @@index([userId])
}

model SentenceDiff {
  id                      String       @id @default(uuid())
  revisionId              String
  sentenceIndex           Int
  originalSentence        String
  revisedSentence         String
  rationale               String
  semanticScore           Float
  claimStrengthWarning    Boolean      @default(false)
  namedEntityWarning      Boolean      @default(false)
  numberOrDateWarning     Boolean      @default(false)
  citationWarning         Boolean      @default(false)
  decision                DiffDecision @default(PENDING)
  createdAt               DateTime     @default(now())
  revision                Revision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@unique([revisionId, sentenceIndex])
}

model TransparencyReport {
  id                          String      @id @default(uuid())
  userId                      String
  projectId                   String
  revisionId                  String
  draftCreatedAt              DateTime
  rewriteRequestedAt          DateTime
  editCount                   Int
  heavilyChangedSections      Json
  usedWritingSamples          Boolean
  notes                       String?
  reportJson                  Json
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  user                        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model ExportJob {
  id                      String       @id @default(uuid())
  userId                  String
  projectId               String
  revisionId              String?
  reportId                String?
  exportType              ExportType
  status                  ExportStatus @default(PENDING)
  storageKey              String?
  signedUrl               String?
  expiresAt               DateTime?
  errorMessage            String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                 Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model AuditEvent {
  id                  String         @id @default(uuid())
  userId              String?
  projectId           String?
  actorType           AuditActorType
  eventName           String
  eventPayload        Json
  createdAt           DateTime       @default(now())
  ipAddress           String?
  userAgent           String?
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([createdAt])
}
